__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Processed images stay ignored. The pre-commit hook force-stages the first
# 10 files (LC_ALL=C order) from every data/*/images directory.
/data/**
!/data/**/
!/data/**/*.jsonl
!/data/splits/**/*.json
/outputs/**
*repomix*
*.zip
.DS_Store
*.tar
